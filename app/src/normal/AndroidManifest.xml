<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@mipmap/codelove_icon"
        android:roundIcon="@mipmap/codelove_icon"
        tools:replace="android:icon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Area de desenvolvimento sem SDL. -->
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />

        <!--
            Important: GameActivity class name MUST be explicitly written as
            "org.love2d.android.GameActivity" without any shortcuts.
        -->
        <activity
            android:name="org.love2d.android.GameActivity"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:exported="false"
            android:launchMode="standard"
            android:process=":codelove_runtime"
            android:screenOrientation="behind"
            tools:replace="android:exported,android:launchMode,android:screenOrientation">
            <intent-filter tools:node="removeAll" />
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>

        <!-- Restart coordinator stays in the editor process, not the SDL process. -->
        <activity
            android:name=".RuntimeRestartActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="behind"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />

        <!-- Replace the inherited unrestricted share receiver in the editor variant. -->
        <activity android:name=".IntentReceiverActivity" tools:node="remove" />
        <activity
            android:name=".LoveArchiveActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-love-game" />
                <data android:mimeType="application/x-love" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.love" />
                <data android:pathSuffix=".love" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-love-game" />
                <data android:mimeType="application/x-love" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <provider
            android:name="org.love2d.android.LoveDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
